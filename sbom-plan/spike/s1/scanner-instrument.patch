+// s1LinkTree (spike instrumentation) hard-links the merged image files into $S1_LINKDIR.
+func s1LinkTree(fileMap map[string]string) {
+	root := os.Getenv("S1_LINKDIR")
+	if root == "" {
+		return
+	}
+	root = filepath.Clean(root)
+	var dirs, links, skipped, errs int
+	for in, real := range fileMap {
+		dst := filepath.Join(root, in)
+		if dst != root && !strings.HasPrefix(dst, root+string(filepath.Separator)) {
+			errs++
+			continue
+		}
+		fi, err := os.Lstat(real)
+		switch {
+		case err != nil:
+			errs++
+		case fi.IsDir():
+			if os.MkdirAll(dst, 0o755) != nil {
+				errs++
+			} else {
+				dirs++
+			}
+		case fi.Mode().IsRegular():
+			if os.MkdirAll(filepath.Dir(dst), 0o755) != nil {
+				errs++
+			} else if err := os.Link(real, dst); err != nil && !os.IsExist(err) {
+				errs++
+			} else {
+				links++
+			}
+		default:
+			skipped++
+		}
+	}
+	log.WithFields(log.Fields{"dirs": dirs, "links": links, "skipped": skipped, "errors": errs}).Info("S1_LINKDIR built")
+}
